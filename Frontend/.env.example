# GreenRoute AI Environment Configuration
# API Backend Base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Demonstration / Mock Mode Toggle
# When true, the application runs full-featured realistic mock data without backend dependency
VITE_USE_MOCK_DATA=true

# Map Vector Tile Style (OpenFreeMap dark vector tiles - 100% free, no key required)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Geocoding Service Configuration (nominatim or ors)
VITE_GEOCODING_PROVIDER=nominatim
# Optional ORS API Key if using OpenRouteService directly
VITE_ORS_API_KEY=

